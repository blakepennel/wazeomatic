<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Exported so adb shell am start -n com.wazeomatic.mockwaze/.MainActivity (with extras) works. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Mock Waze settings"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Holds the dynamically registered HAZARD_DETECTED receiver while auto macro is on.
             A manifest receiver would not work: since Android 8 implicit broadcasts are not
             delivered to manifest receivers. -->
        <service
            android:name=".AutoMacroService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Test harness: listens for hazard broadcasts and replays the report macro" />
        </service>

        <!-- Only receives SET_TIMING when it is sent with an explicit package
             (am broadcast with -p com.wazeomatic.mockwaze). While the app is open the
             activity/service also register for it dynamically, so -p is optional then. -->
        <receiver
            android:name=".ControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.wazeomatic.mockwaze.SET_TIMING" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
