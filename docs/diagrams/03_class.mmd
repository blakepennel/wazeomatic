classDiagram
    direction TB

    class FrameSource {
        <<interface>>
        +nextFrame() Frame
    }
    class CameraSource
    class VideoSource
    class OnnxDetector {
        +labels: List~String~
        +size: Int
        +conf_thres: Float
        +iou_thres: Float
        +last_ms: Float
        +detect(frame) List~Detection~
    }
    class ZoomDetector {
        +crop = 0.25, 0.35, 0.75, 0.75
        +detect(frame) List~Detection~
    }
    class EnsembleDetector {
        +fusion = wbf
        +weights: List~Float~
        +detect(frame) List~Detection~
    }
    class HoodEstimator {
        +min_frac = 0.10
        +max_frac = 0.40
        +update(frame) Float
    }
    class Detection {
        +label: String
        +confidence: Float
        +bbox: xywh normalized
        +model: String
    }
    class Pipeline {
        +process(frame) List~HazardEvent~
        +run(source) PipelineStats
    }
    class ReportConfig {
        +window = 10
        +min_hits = 3
        +min_confidence = 0.40
        +min_confidence_by_label = pothole 0.55
        +hood_frac = 0.10
        +cooldown_s = 60
        +global_cooldown_s = 60
        +track_iou = 0
        +stopped_vehicle_enabled = false
    }
    class ReportManager {
        +held_back: Int
        +set_hood_frac(frac)
        +update(detections, frame_index) List~HazardEvent~
    }
    class HazardType {
        +key: String
        +waze_category: String
        +waze_subcategory: String
    }
    class HazardEvent {
        +hazard_type: String
        +confidence: Float
        +source: String
        +ts: Float
        +schema: Int
        +to_json() String
        +intent_extras() Map
    }
    class EventSink {
        <<interface>>
        +send(event) void
    }
    class BroadcastSink
    class TcpSink
    class StdoutSink
    class AdbBroadcastSink {
        +dry_run = true
    }
    class MacroDroidMacro {
        <<external>>
        +hazard_type: String
        +DRY_RUN: Boolean
    }

    CameraSource ..|> FrameSource
    VideoSource ..|> FrameSource
    Pipeline --> FrameSource : reads
    Pipeline --> OnnxDetector : runs
    Pipeline --> HoodEstimator
    Pipeline --> ReportManager
    Pipeline --> EventSink : sends
    ZoomDetector --> OnnxDetector : full frame + crop
    EnsembleDetector --> ZoomDetector : optional second hazard model
    OnnxDetector ..> Detection : creates
    HoodEstimator ..> ReportManager : hood zone
    ReportManager --> ReportConfig
    ReportManager --> Detection : consumes
    ReportManager ..> HazardEvent : creates
    HazardEvent --> HazardType : maps to
    BroadcastSink ..|> EventSink
    TcpSink ..|> EventSink
    StdoutSink ..|> EventSink
    AdbBroadcastSink ..|> EventSink
    BroadcastSink ..> MacroDroidMacro : Intent
